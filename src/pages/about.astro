---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar.jpg';
import { SITE } from '../consts';
---

<BaseLayout title="关于我">
  <header class="about-header">
    <Image
      class="about-header__avatar"
      src={avatar}
      alt=""
      width={72}
      height={72}
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <div>
      <h1 class="about-header__name">{SITE.author}</h1>
      <p class="about-header__meta">{SITE.description}</p>
    </div>
  </header>

  <div class="prose">
    <p>
      做具身智能与航天两个方向。两边做的事情其实是同一套：一边让机器按预期动，一边从图像里把状态量出来。
    </p>

    <h2>具身智能</h2>

    <p>这一侧是让本体动起来的部分：电机控制落在执行，系统辨识把对象模型弄清楚。</p>

    <p>
      <strong>无位置传感器电机控制</strong> —— PMSM 的 FOC。有感部分作为入门过渡，主线放在无感。按「抓文献
      → 复现 baseline → 提假设 → 跑实验」的顺序推进，仿真侧用 MATLAB/Simulink 搭 SPMSM 模型。
    </p>

    <p>
      <strong>系统辨识</strong> —— 从输入输出记录反推对象模型，方法是最小二乘与 ARX，配套数据预处理、模型阶次选择与验证脚本。模型先准，控制器的整定才有依据。
    </p>

    <h2>航天</h2>

    <p>这一侧是从图像里取状态量：给的是相对位姿，做的是复现与任务适配。</p>

    <p>
      <strong>6-DoF 相对位姿估计</strong> —— 从单目或多源传感器数据估计目标航天器相对相机的六自由度位姿，场景覆盖在轨服务、交会对接与主动碎片清除。基于 SPNv2 做复现，再把特征适配到具体任务上。
    </p>

    <p>
      <strong>可视化与基础视觉</strong> —— SPNv2 的前向计算、反向传播与优化循环做成了浏览器端的三维演示，      用来看清每一步在做什么；另有一组不依赖训练的经典分割，HSV 阈值加形态学，输出二值掩膜与轮廓。
    </p>

    <p>具体在做的项目列在<a href="/projects/">项目</a>页。</p>

    <h2>技术栈</h2>

    <div class="table-wrap">
      <table>
      <caption class="visually-hidden">技术栈</caption>
      <thead>
        <tr>
          <th scope="col">方向</th>
          <th scope="col">用的东西</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">具身智能</th>
          <td>MATLAB / Simulink、FOC、SVPWM、最小二乘、ARX、Bode 与稳定裕度分析</td>
        </tr>
        <tr>
          <th scope="row">航天</th>
          <td>Python、PyTorch、OpenCV、NumPy / SciPy / scikit-image、SPNv2、6-DoF 位姿</td>
        </tr>
        <tr>
          <th scope="row">工业过程</th>
          <td>FOPDT / SOPDT / IPDT 对象模型、PID 整定、串级回路、SIMC / IMC / ZN / Cohen-Coon / CHR / AMIGO / Tyreus-Luyben</td>
        </tr>
        <tr>
          <th scope="row">前端工具</th>
          <td>原生 JavaScript + Canvas、Three.js，静态实现、离线可运行</td>
        </tr>
      </tbody>
      </table>
    </div>

    <h2>这个站</h2>

    <p>
      Astro 5 搭的静态站，源码在 <a href={SITE.repo} rel="noopener" target="_blank">GitHub</a>。文章在<a
        href="/blog/">博客</a
      >，项目在<a href="/projects/">项目</a>，两边都会更新，但节奏不同——项目页随进展改，文章写得慢。
    </p>

    <h2>联系方式</h2>

    <p>
      GitHub：<a href={`https://github.com/${SITE.github}`} rel="noopener" target="_blank"
        >{SITE.github}</a
      >　·　CSDN：<a
        href={`https://blog.csdn.net/${SITE.csdn}`}
        rel="noopener"
        target="_blank">{SITE.csdn}</a
      >　·　邮箱：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>

    <!-- 教育背景待补充（学校 / 专业 / 学位 / 起止时间），补齐后再加回本节 -->
  </div>
</BaseLayout>
