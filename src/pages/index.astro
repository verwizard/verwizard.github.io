---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getPublishedPosts } from '../lib/posts';
import { HOME_INTRO, HOME_TOPICS } from '../consts';

const posts = await getPublishedPosts();
---

<BaseLayout title="具身智能与航天">
  <section class="home-intro">
    <h1 class="home-intro__title">具身智能与航天</h1>
    <p class="home-intro__lead">{HOME_INTRO}</p>
    <ul class="home-intro__topics" aria-label="研究方向">
      {HOME_TOPICS.map((topic) => <li>{topic}</li>)}
    </ul>
    <div class="home-intro__actions">
      <a class="btn" href="/projects/">项目</a>
      <a class="btn" href="/blog/">文章</a>
      <a class="btn" href="/about/">关于我</a>
    </div>
  </section>

  <section id="blog">
    {
      posts.length > 0 ? (
        <>
          <h2 class="group-title">最新文章</h2>
          <ul class="post-list">
            {posts.map((post) => (
              <PostListItem post={post} />
            ))}
          </ul>
        </>
      ) : (
        <p class="page-desc">暂时还没有文章。</p>
      )
    }
  </section>
</BaseLayout>
