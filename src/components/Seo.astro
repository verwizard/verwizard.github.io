---
import { SITE } from '../consts';
import { siteSchema, blogPostingSchema, toJsonLd } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonical?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
  canonical: withCanonical = true,
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${SITE.title}`
  : `${SITE.title} · ${SITE.subtitle}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;

// 固定路径：分享卡片缓存不随构建失效
const ogImageUrl = new URL('/og.jpg', SITE.url).href;

const jsonLd = publishedTime
  ? blogPostingSchema({
      title: pageTitle,
      description,
      url: canonicalUrl,
      datePublished: publishedTime,
      dateModified: modifiedTime,
    })
  : siteSchema();
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{withCanonical && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={SITE.author} />
<meta name="google-site-verification" content={SITE.googleVerification} />

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE.description} />
{
  publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href="/rss.xml"
/>

<script type="application/ld+json" set:html={toJsonLd(jsonLd)}></script>
